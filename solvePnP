import cv2
import numpy as np
import imutils
from imutils.video import VideoStream
import time
import sys

print("[INFO] Loading Camera Calibration files...")
try:
    # These are the files generated by your calibrate_camera.py script
    camera_matrix = np.load('camera_matrix.npy')
    dist_coeffs = np.load('dist_coeffs.npy')
    print("[INFO] Camera Calibration loaded successfully! 👓")
except Exception as e:
    print(f"[ERROR] Could not find calibration files: {e}")
    print("[ERROR] You MUST run calibrate_camera.py first to generate the .npy files.")
    sys.exit(0)

# ================================================ =================
# IMPORTANT: Measure the black square of your printed marker!
# Update this value to exactly match your physical printout in CM.
# =================================================================
marker_size_cm = 10
half = marker_size_cm / 2.0

# We mathematically define a flat 10cm square in 3D space (Z=0 because it's flat paper)
# Coordinates: (X, Y, Z)
marker_3d_edges = np.array([
    [-half,  half, 0],  # Top-Left corner
    [ half,  half, 0],  # Top-Right corner
    [ half, -half, 0],  # Bottom-Right corner
    [-half, -half, 0]   # Bottom-Left corner
], dtype=np.float32)

print("[INFO] Initializing ArUco Detector (5x5_100)...")
arucoDict = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_5X5_100)
arucoParams = cv2.aruco.DetectorParameters()
detector = cv2.aruco.ArucoDetector(arucoDict, arucoParams)

print("[INFO] Starting video stream... (Press 'q' to quit)")
vs = VideoStream(src=0).start()
time.sleep(2.0) # Let the camera sensor warm up

while True:
    frame = vs.read()
    if frame is None:
        print("[ERROR] Camera disconnected.")
        break
    
    # Resize to a consistent width for processing speed
    #frame = imutils.resize(frame, width=500)
    print(frame.shape)
    
    # Find the exact center of the screen
    height, width, _ = frame.shape
    screen_cX = int(width / 2.0)
    screen_cY = int(height / 2.0)
    
    # Draw green crosshairs
    cv2.line(frame, (screen_cX - 20, screen_cY), (screen_cX + 20, screen_cY), (0, 255, 0), 2)
    cv2.line(frame, (screen_cX, screen_cY - 20), (screen_cX, screen_cY + 20), (0, 255, 0), 2)
    
    # Detect markers in the current frame
    (corners, ids, rejected) = detector.detectMarkers(frame)

    if len(corners) > 0:
        ids = ids.flatten()

        for (markerCorner, markerID) in zip(corners, ids):
            # The 2D pixels the camera saw on the screen
            marker_2d_pixels = markerCorner.reshape((4, 2))
            center = np.mean(marker_2d_pixels, axis=0).astype(int)
            cv2.circle(frame, tuple(center), 6, (0, 0, 255), 2)

            # DO THE 3D MATH (solvePnP)
            # Compare the physical size to the 2D pixels, pushing it 
            # through your lens distortion data to calculate exact 3D position!
            success, rvec, tvec = cv2.solvePnP(
                marker_3d_edges,
                marker_2d_pixels,
                camera_matrix,
                dist_coeffs,
                flags=cv2.SOLVEPNP_IPPE_SQUARE
            )

            if success:
                # tvec is the Translation Vector [X, Y, Z] in CENTIMETERS
                x_dist = tvec[0][0] # Left/Right distance
                y_dist = tvec[1][0] # Up/Down distance
                z_dist = tvec[2][0] # Altitude (Distance from camera)
                print(f"X = {x_dist:.2f} cm")
                print(f"Y = {y_dist:.2f} cm")
                print(f"Z = {z_dist:.2f} cm")

                # Draw the 3D axes sticking out of the marker on the screen!
                # Red=X (Right), Green=Y (Down), Blue=Z (Forward/Depth)
                cv2.drawFrameAxes(frame, camera_matrix, dist_coeffs, rvec, tvec, 5.0)

                if markerID == 24: # Target Pad
                    color = (0, 255, 0)
                    cv2.putText(frame, "TARGET ACQUIRED", (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1.0, color, 3)
                    
                    # Altitude/Z-Axis Logic
                    if z_dist <= 30.0:
                        cv2.putText(frame, f"ALT: {z_dist:.1f}cm - READY TO LAND", (50, 100), cv2.FONT_HERSHEY_SIMPLEX, 1.0, color, 3)
                    else:
                        cv2.putText(frame, f"ALT: {z_dist:.1f}cm - DESCENDING...", (50, 100), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (255, 0, 0), 3)
                        
                    # Alignment/X-Axis Logic
                   # X-axis alignment
                    if x_dist > 2:
                        cv2.putText(frame,
                f"CMD: MOVE RIGHT ({x_dist:.1f} cm)",
                (50,150),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0,255,0),
                2)
                    elif x_dist < -2:
                       cv2.putText(frame,
                f"CMD: MOVE LEFT ({abs(x_dist):.1f} cm)",
                (50,150),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0,255,0),
                2)
                    else:
                       cv2.putText(frame,
                "CMD: X-AXIS CENTERED",
                (50,150),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0,255,0),
                2)

                    # Y-axis alignment
                    if y_dist > 2:
                      cv2.putText(frame,
                f"CMD: MOVE DOWN ({y_dist:.1f} cm)",
                (50,190),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (255,255,0),
                2)
                    elif y_dist < -2:
                       cv2.putText(frame,
                f"CMD: MOVE UP ({y_dist:.1f} cm)",
                (50,190),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (255,255,0),
                2)
                    else:
                           cv2.putText(frame,
                "CMD: Y-AXIS CENTERED",
                (50,190),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0,255,0),
                2)

                    

    cv2.imshow("3D Flight HUD", frame)
    
    # Break the loop if 'q' is pressed
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

# Safely close everything

print("[INFO] Shutting down...")
cv2.destroyAllWindows()
vs.stop()